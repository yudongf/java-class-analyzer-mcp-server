{
    "mcpServers": {
        "java-class-analyzer": {
            "command": "java-class-analyzer-mcp",
            "args": ["start"],
            "env": {
                "NODE_ENV": "production",
                "MAVEN_REPO": "${HOME}/.m2/repository",
                "JAVA_HOME": "${JAVA_HOME}",
                "CFR_PATH": ""
            }
        }
    }
}